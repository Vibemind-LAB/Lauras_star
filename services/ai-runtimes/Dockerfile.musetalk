FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive
ARG MUSETALK_REPO=https://github.com/TMElyralab/MuseTalk
ARG MUSETALK_REF=main

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LAURA_RUNTIME_KIND=vibevideo \
    LAURA_RUNTIME_MODE=model \
    LAURA_RUNTIME_PROVIDER=musetalk \
    LAURA_RUNTIME_PORT=8901 \
    LAURA_MODEL_ROOT=/models \
    LAURA_MUSETALK_REPO=/models/MuseTalk \
    LAURA_MUSETALK_RESULT_DIR=/workspace/musetalk-results \
    LAURA_MUSETALK_VERSION=v15 \
    LAURA_MUSETALK_OUTPUT_GLOB=**/*.mp4 \
    LAURA_MUSETALK_EXTRA_ARGS=--use_float16

WORKDIR /opt/laura-runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        git \
        libglib2.0-0 \
        libgl1 \
        libgomp1 \
        libsm6 \
        libsndfile1 \
        libxext6 \
        python-is-python3 \
        python3-pip \
        python3.10 \
        python3.10-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python -m pip install --no-cache-dir \
        torch==2.0.1 \
        torchvision==0.15.2 \
        torchaudio==2.0.2 \
        --index-url https://download.pytorch.org/whl/cu118

RUN git clone --depth 1 --branch "$MUSETALK_REF" "$MUSETALK_REPO" /opt/MuseTalk \
    && python -m pip install --no-cache-dir -r /opt/MuseTalk/requirements.txt \
    && python -m pip install --no-cache-dir -U openmim \
    && mim install mmengine \
    && mim install "mmcv==2.0.1" \
    && mim install "mmdet==3.1.0"

RUN python -m pip install --no-cache-dir --no-build-isolation "chumpy==0.70" \
    && mim install "mmpose==1.1.0"

RUN useradd --create-home --uid 10001 laura \
    && mkdir -p /models /workspace \
    && chown -R laura:laura /models /workspace /opt/laura-runtime

COPY runtime_server.py /opt/laura-runtime/runtime_server.py
COPY providers /opt/laura-runtime/providers

USER laura

EXPOSE 8901

CMD ["python", "/opt/laura-runtime/runtime_server.py"]
