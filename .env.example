# Laura environment (copy to .env; never commit real secrets).

# --- Local service ---
LAURA_HOST=127.0.0.1
LAURA_PORT=8765
LAURA_WORKSPACE=./workspace
# Session token for the API. EMPTY = auth disabled (every local caller is trusted) —
# fine for a loopback dev run, not for anything else. scripts/setup.sh|ps1 generates
# a random one when it creates your .env; the desktop app manages its own.
LAURA_TOKEN=

# --- FFmpeg (optional overrides; else taken from PATH) ---
# LAURA_FFMPEG=/usr/bin/ffmpeg
# LAURA_FFPROBE=/usr/bin/ffprobe

# --- Analysis extras ---
# Hugging Face token for pyannote diarization (extra: diarize).
HF_TOKEN=

# --- NL-Agent Short-Creator (extra: autoshort; docs/agentic-short-creator.md) ---
# Reasoning-Modell der Agenten (Ollama-Tag; nur :7b ist typischerweise gepullt).
LAURA_AGENT_MODEL=qwen2.5:7b
# VLM fuer describe_moment / Uebergangs-Review (Ollama).
LAURA_VLM_MODEL=qwen2.5vl:7b
# Orchestrierung: magentic (primaer) | graph (deterministischer Fallback erzwingen).
LAURA_AGENT_ORCHESTRATION=graph
# Optional: comma-separated failover pool for the agent model (stage A; the orchestrator
# keeps its own LAURA_ORCHESTRATOR_MODEL).
# The active LAURA_AGENT_MODEL always leads; on repeated empty/5xx/429 failures the
# run advances to the next model and stays there (free-tier serving varies per model/day).
# LAURA_AGENT_MODEL_POOL=openrouter/nvidia/nemotron-3-super-120b-a12b:free,openrouter/google/gemma-4-31b:free,openrouter/tencent/hunyuan-a13b-instruct:free
# Eskalation Stufe B (9router, optional).
# LAURA_9ROUTER_API_KEY=
# LAURA_AGENT_ESCALATE_MODEL=cc/claude-sonnet-4-5

# Text-Agenten DIREKT ueber 9router statt Ollama (Stage A; Gateway muss laufen):
# LAURA_AGENT_PROVIDER=9router
# LAURA_AGENT_MODEL=cc/claude-sonnet-4-5
# LAURA_9ROUTER_BASE_URL=http://localhost:20128/v1

# VLM ueber OpenRouter statt lokalem Ollama (entlastet die 12GB-GPU; freie
# Vision-Modelle verfuegbar, Free-Tier rotiert -> Modell ggf. anpassen):
# LAURA_VLM_PROVIDER=openrouter
# LAURA_OPENROUTER_API_KEY=
# LAURA_VLM_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
# Optional: comma-separated failover pool (sticky on last successful model).
# LAURA_VLM_MODEL_POOL=nvidia/nemotron-nano-12b-v2-vl:free,qwen/qwen2.5-vl-72b-instruct:free

# --- Voiceover / TTS backend (docs/17-runbook.md) ---
# Which engine synthesizes narration: stub (dependency-free tone, default) | sapi
# (Windows system voice) | elevenlabs (cloud, needs the key below) | sidecar (local
# neural voice cloning via services/tts-sidecar) | auto (sapi if present, else stub).
LAURA_VOICEOVER_BACKEND=stub
# Sidecar endpoint + timeout (only for LAURA_VOICEOVER_BACKEND=sidecar).
# Start the sidecar in its OWN venv - see services/tts-sidecar/README.md, and set
# HF_HUB_OFFLINE=1 there once the weights are cached (cold start otherwise hits
# Hugging Face throttling and can exceed this timeout).
# LAURA_VOICEOVER_URL=http://127.0.0.1:8898
# LAURA_VOICEOVER_TIMEOUT=180

# --- Voice-Neufassung (Slice 3; ElevenLabs TTS) ---
# Ohne Key degradiert die Voice-Synthese graceful (ok=False mit Grund).
LAURA_ELEVENLABS_API_KEY=
# Default-Stimme (Voice-Id aus deinem ElevenLabs-Konto).
LAURA_ELEVENLABS_VOICE=
# Optional: TTS model id (default eleven_multilingual_v2).
# LAURA_ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Server / on-prem mode (docs/14-enterprise.md) ---
# NUR fuer Server-Deployments einkommentieren: eine gesetzte DATABASE_URL schaltet das
# Backend von SQLite auf Postgres um — auf dem Desktop bleibt der Block auskommentiert.
# DATABASE_URL=postgresql://laura:laura@localhost:5432/laura
# REDIS_URL=redis://localhost:6379/0
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# S3/MinIO object storage
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=laura
# S3_SECRET_KEY=laura-secret
# S3_BUCKET=laura
