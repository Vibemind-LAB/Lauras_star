# Laura environment (copy to .env; never commit real secrets).

# --- Local service ---
LAURA_HOST=127.0.0.1
LAURA_PORT=8765
LAURA_WORKSPACE=./workspace
# Session token required on the API (the desktop app sets this automatically).
LAURA_TOKEN=

# --- FFmpeg (optional overrides; else taken from PATH) ---
# LAURA_FFMPEG=/usr/bin/ffmpeg
# LAURA_FFPROBE=/usr/bin/ffprobe

# --- Analysis extras ---
# Hugging Face token for pyannote diarization (extra: diarize).
HF_TOKEN=

# --- NL-Agent Short-Creator (extra: autoshort; docs/agentic-short-creator.md) ---
# Reasoning-Modell der Agenten (Ollama-Tag; nur :7b ist typischerweise gepullt).
LAURA_AGENT_MODEL=qwen2.5:7b
# VLM fuer describe_moment / Uebergangs-Review (Ollama).
LAURA_VLM_MODEL=qwen2.5vl:7b
# Orchestrierung: magentic (primaer) | graph (deterministischer Fallback erzwingen).
LAURA_AGENT_ORCHESTRATION=graph
# Eskalation Stufe B (9router, optional).
# LAURA_9ROUTER_API_KEY=
# LAURA_AGENT_ESCALATE_MODEL=cc/claude-sonnet-4-5

# --- Voice-Neufassung (Slice 3; ElevenLabs TTS) ---
# Ohne Key degradiert die Voice-Synthese graceful (ok=False mit Grund).
LAURA_ELEVENLABS_API_KEY=
# Default-Stimme (Voice-Id aus deinem ElevenLabs-Konto).
LAURA_ELEVENLABS_VOICE=

# --- Server / on-prem mode (docs/14-enterprise.md) ---
DATABASE_URL=postgresql://laura:laura@localhost:5432/laura
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# S3/MinIO object storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=laura
S3_SECRET_KEY=laura-secret
S3_BUCKET=laura
